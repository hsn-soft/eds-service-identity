<Project Sdk="Microsoft.NET.Sdk.Web">

    <Import Project="..\..\common.version.props" />

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <RootNamespace>Eds.IdentityService</RootNamespace>
        <Title>HsnSoft Eds Identity Service</Title>
        <Product>HsnSoft Eds Identity Service</Product>
        <Description>HsnSoft Eds Identity Service</Description>
        <Authors>HsnSoft</Authors>
        <Copyright>2024</Copyright>
        <NoWarn>$(NoWarn);CS1591;CS1998;</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Eds.Shared.Hosting.Microservices" Version="$(EdsSharedVersion)" />
        <!--<ProjectReference Include="..\..\..\..\shared\src\Eds.Shared.Hosting.Microservices\Eds.Shared.Hosting.Microservices.csproj" />-->
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Eds.IdentityService.Application\Eds.IdentityService.Application.csproj" />
        <ProjectReference Include="..\Eds.IdentityService.EntityFrameworkCore\Eds.IdentityService.EntityFrameworkCore.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\public_key.xml">
            <Link>public_key.xml</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Logs\**" />
        <Content Remove="Logs\**" />
        <EmbeddedResource Remove="Logs\**" />
        <None Remove="Logs\**" />
    </ItemGroup>

</Project>